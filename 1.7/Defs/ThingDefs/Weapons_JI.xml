  <ThingDef ParentName="BaseBullet" MayRequire="rimsenal.core">
    <defName>Bullet_Sigrun</defName>
    <label>sigrun slug</label>
    <graphicData>
      <texPath>Things/Projectile/Slug</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>17</damageAmountBase>
      <speed>100</speed>
      <stoppingPower>1</stoppingPower>
      <armorPenetrationBase>0.55</armorPenetrationBase>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseJIGun" MayRequire="rimsenal.core">
    <defName>JI_Sigrun</defName>
    <label>ULM recon carbine</label>
    <description>A Jotun Interstellar ULM pistol modified into a carbine. While it loses some of the manufacturer’s iconic firepower and armor-piercing capability, it’s much easier to handle, fires faster, and still packs a punch.

Jotun Interstellar JP-1844/R “Sigrun” ULM (Ultra-density Liquefied Metal) Recon Carbine

Designed primarily for export rather than domestic use, this pistol-carbine has earned a solid reputation for its user-friendly design and surprisingly potent firepower.
While most Jotunheim warriors complain that it feels too light and that its design prioritizes trivial features over raw destructive power, Askbarn scouts praise the Sigrun precisely for those same qualities.</description>
    <graphicData>
      <texPath>Things/Weapons/Sigrun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_ChargeRifle</soundInteract>
    <weaponTags>
	   <li>SpacerGun</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <statBases>
      <Mass>3.4</Mass>
      <WorkToMake>41500</WorkToMake>
      <AccuracyTouch>0.61</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.82</AccuracyMedium>
      <AccuracyLong>0.69</AccuracyLong>
      <RangedWeapon_Cooldown>0.92</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <Plasteel>30</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_Sigrun</defaultProjectile>
        <warmupTime>0.82</warmupTime>
        <range>26.9</range>
        <soundCast>RS_ShotJI</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>
  
  
