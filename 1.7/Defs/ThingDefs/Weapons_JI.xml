	<ThingDef ParentName="BaseBullet" MayRequire="rimsenal.EVP">
		<defName>Bullet_FusterClucker</defName>
		<label>EMP blast</label>
		<thingClass>Projectile_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/RaceBallLightning</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<projectile>
			<explosionRadius>2.0</explosionRadius>
			<damageDef>EMP</damageDef>
			<damageAmountBase>100</damageAmountBase>
			<speed>40</speed>
		</projectile>
	</ThingDef>


	<ThingDef ParentName="BaseHumanMakeableGun" MayRequire="rimsenal.EVP">
		<defName>Gun_FusterClucker</defName>
		<label>fuster clucker</label>
		<description>A very long-range, high-powered EMP weapon designed to neutralize heavily automated defense positions from a distance.

Its official designation is the "Precision Long-Range Electromagnetic Pulse Projection System", but most Rimworlders call it the "Fuster Clucker"—for reasons that become obvious once it's fired.</description>
		<graphicData>
			<texPath>Things/Weapons/fusterclucker</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_ChargeRifle</soundInteract>
		<equippedAngleOffset>45</equippedAngleOffset>
		<statBases>
			<WorkToMake>71500</WorkToMake>
			<Mass>8.8</Mass>
			<AccuracyTouch>0.80</AccuracyTouch>
			<AccuracyShort>0.73</AccuracyShort>
			<AccuracyMedium>0.78</AccuracyMedium>
			<AccuracyLong>0.55</AccuracyLong>
			<RangedWeapon_Cooldown>3.1</RangedWeapon_Cooldown>
		</statBases>
		<recipeMaker>
			<researchPrerequisite>DirectedEMP</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>11</Crafting>
      </skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>45</Steel>
			<Plasteel>55</Plasteel>
			<ComponentSpacer>5</ComponentSpacer>
		</costList>
		<generateCommonality>0.1</generateCommonality>
		<techLevel>Spacer</techLevel>
		<weaponTags>
			<li>SpacerGun</li>
		</weaponTags>
		<verbs>
			<li>
				<forcedMissRadius>0.5</forcedMissRadius>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_FusterClucker</defaultProjectile>
				<warmupTime>4.2</warmupTime>
				<range>55</range>
				<burstShotCount>1</burstShotCount>
				<soundCast>Shot_ChargeRifle</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>18</muzzleFlashScale>
			</li>
		</verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>10</power>
        <cooldownTime>1.9</cooldownTime>
      </li>
    </tools>
	</ThingDef>

  
